# Copia este archivo como .env y rellena los valores.

# Credenciales del admin (panel /admin). El email es texto plano, la
# contraseña se guarda como hash bcrypt (nunca en texto plano).
# Genera el hash con:  node server/src/hashPassword.js "tu-contraseña"
#
# ¡IMPORTANTE! El hash generado contiene signos "$" (p.ej. $2a$10$...).
# Docker Compose interpreta "$" como inicio de variable en los ficheros .env,
# así que aquí tienes que ESCAPAR cada "$" duplicándolo por "$$".
# Ejemplo: si hashPassword.js te da   $2a$10$abc123.../XYZ
# pégalo aquí como                    $$2a$$10$$abc123.../XYZ
ADMIN_EMAIL=tuemail@example.com
ADMIN_PASSWORD_HASH=

# Cadena aleatoria larga para firmar la sesión de admin. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=8080
