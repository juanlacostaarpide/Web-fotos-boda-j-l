rules_version = '2';

// Firestore vive únicamente en el proyecto "FOTOS" y guarda la metadata
// de TODOS los archivos (fotos y vídeos), aunque los originales de vídeo
// vivan en el Storage del proyecto "VÍDEOS".
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Pega aquí el UID de tu usuario admin (email/password) del proyecto FOTOS.
    // Lo obtienes en Firebase Console → Authentication → Users, tras crear tu cuenta.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REEMPLAZA_CON_TU_UID_PROYECTO_FOTOS';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Colección "media": un documento por foto o vídeo subido.
    // Campos esperados: type ("foto" | "video"), uploaderUid, uploaderName,
    // createdAt, originalPath, thumbPath.
    match /media/{mediaId} {
      // Cualquier invitado autenticado (aunque sea de forma anónima) puede
      // leer la galería completa.
      allow read: if isSignedIn();

      // Un invitado solo puede crear metadata de SU PROPIA subida, y no puede
      // modificarla ni borrarla después.
      allow create: if isSignedIn()
        && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.type in ['foto', 'video'];

      allow update: if false;

      // Solo el admin puede borrar documentos (p. ej. contenido inapropiado).
      allow delete: if isAdmin();
    }
  }
}
