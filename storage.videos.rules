rules_version = '2';

// Storage del proyecto "VÍDEOS".
// Estructura de carpetas:
//   /originals/{uid}/{fileName}   → vídeo original (máx. 60s / 100MB), NUNCA legible por invitados
//   /thumbnails/{uid}/{fileName}  → frame estático capturado en el navegador (preview en galería)
//
// OJO: el UID de un mismo invitado (o del admin) es DISTINTO en este proyecto respecto
// al proyecto de FOTOS, porque cada proyecto Firebase tiene su propio Authentication.
service firebase.storage {
  match /b/{bucket}/o {

    // ⚠️ Pega aquí el UID de tu usuario admin (email/password) del proyecto VÍDEOS.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'REEMPLAZA_CON_TU_UID_PROYECTO_VIDEOS';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isReasonableVideo() {
      return request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    function isReasonableThumbnail() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /originals/{uid}/{fileName} {
      // Solo el admin puede leer (y por tanto descargar) los vídeos originales.
      allow read: if isAdmin();
      allow write: if isOwner(uid) && isReasonableVideo();
    }

    match /thumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isOwner(uid) && isReasonableThumbnail();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
